{
  "expo": {
    "name": "Howl",
    "slug": "howl",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.upvt.howl"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B21B6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.upvt.howl",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "howl",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Howl necesita acceso a tus fotos y videos para que puedas publicarlos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6D28D9",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6D28D9"
        }
      ],
      "expo-video",
      "expo-font"
    ],
    "updates": {
      "url": "https://u.expo.dev/628c21af-7aa7-4def-b05d-135408b3e66a"
    },
    "extra": {
      "eas": {
        "projectId": "628c21af-7aa7-4def-b05d-135408b3e66a"
      }
    }
  }
}
